# Environment
ENV=development

# Database (SQLite default for local dev)
DATABASE_URL=sqlite:///./de_forge.db

# OpenAI-compatible API Configuration
OPENAI_API_KEY=your_api_key_here
OPENAI_BASE_URL=https://shopapikey.com/v1
OPENAI_MODEL=cx/gpt-5.5

# Server
PORT=8000
HOST=0.0.0.0

# Logging
LOG_LEVEL=INFO

# Agent Configuration
MAX_STATIC_REFINEMENT_ITERATIONS=3
MAX_DYNAMIC_REFINEMENT_ITERATIONS=2

# Security
SECRET_KEY=change_this_in_production
